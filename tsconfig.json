{
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "lib": ["ES2022"],
      "strict": false,
      "noImplicitAny": true,
      "removeComments": true,
      "preserveConstEnums": true,
      "inlineSourceMap": true,
      "rootDir": "./src",
      "outDir": "./dist"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "test",
        "**/*-test.ts"
    ]
}
